{
  "name": "a-cut-2dpro-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "A-Cut 2Dpro — نسخهٔ ویندوز (Electron / اینستالر NSIS با بروزرسانی خودکار)",
  "author": "Abbas Koroushad",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "pack:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.acut.cut2dpro",
    "productName": "A-Cut 2Dpro",
    "copyright": "Copyright © 2026 Abbas Koroushad",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json",
      "web/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "A-Cut-2Dpro-${version}-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "A-Cut 2Dpro",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gase99",
        "repo": "Webxplusx",
        "releaseType": "release"
      }
    ]
  }
}

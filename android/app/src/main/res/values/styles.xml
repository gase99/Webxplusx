<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      A-Cut 2Dpro — تم‌های اندروید
      =========================================================
      نکتهٔ مهم UI: پیش از این، تم پیش‌فرض `Theme.AppCompat.Light.DarkActionBar`
      بود؛ نتیجه این بود که بالای WebView یک نوار/هدر بومی (ActionBar با نام
      برنامه) دیده می‌شد و همان نوار، فضای بالای صفحه را هدر می‌داد.
      اکنون:
        * `AppTheme` روی NoActionBar است (هیچ نوار عنوانی وجود ندارد).
        * `windowNoTitle=true` و `windowActionBar=false` هم صریحاً تنظیم شده‌اند.
        * رنگ نوار وضعیت و ناوبری همرنگ برنامه است تا مرز محتوا مشخص باشد؛
          فاصلهٔ امن (safe-area) از دو مسیر واحد مدیریت می‌شود:
          `SystemBars.insetsHandling = native` در capacitor.config.ts و
          `env(safe-area-inset-*)` در CSS. در MainActivity هیچ padding دستی
          اعمال نمی‌شود (وگرنه فاصله دو بار حساب می‌شد).
    -->

    <!-- تم پایهٔ برنامه: بدون ActionBar، بدون عنوان -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- پس‌زمینهٔ WebView/پنجره، همرنگ بدنهٔ برنامه (بدون فلش سفید) -->
        <item name="android:windowBackground">@color/appBackground</item>
        <!--
          رنگ نوارهای سیستم و روشن‌بودن آیکون‌ها. (این ویژگی‌ها از API 21 وجود
          دارند و minSdk برنامه ۲۴ است، پس نیازی به پوشهٔ values-v21 نیست؛
          در صورت افزودن ویژگی‌های جدیدتر، همان‌جا بازتعریف شوند.)
        -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/appBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- سازگاری با کد/پیکربندی‌های قدیمی که NoActionBar را مستقیم صدا می‌زنند -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      تم صفحهٔ شروع (Splash). والد آن `Theme.SplashScreen` از کتابخانهٔ
      core-splashscreen است و خودش بدون ActionBar است؛ پس فقط پس‌زمینه لازم است.
      (Capacitor هم در BridgeActivity صریحاً `AppTheme.NoActionBar` را ست می‌کند.)
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
